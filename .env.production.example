# === Backend (Railway) ===
# These are set automatically by Railway's managed PostgreSQL/Redis add-ons:
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Token lifetime
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI — get key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Environment
APP_ENV=production

# CORS — set to your Vercel frontend URL (comma-separated for multiple)
BACKEND_CORS_ORIGINS=https://your-app.vercel.app

# === Frontend (Vercel) ===
# Set in Vercel dashboard → Settings → Environment Variables:
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app
